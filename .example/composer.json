{
    "name": "precision-soft/symfony-doctrine-audit-example",
    "description": "The product nomenclator of a shop - categories, products, sales channels and discount offers whose every change is written to an audit trail in a second database and to a jsonl file, read back and retired through the bundle's commands - whose test suite exercises every public capability of precision-soft/symfony-doctrine-audit on the real engines",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/orm": "^3.0",
        "precision-soft/symfony-doctrine-audit": "*@dev",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/framework-bundle": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/phpunit-bridge": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "PrecisionSoft\\Doctrine\\Audit\\Example\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PrecisionSoft\\Dev\\PhpStan\\": "../.dev/phpstan/",
            "PrecisionSoft\\Doctrine\\Audit\\Example\\Test\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "test": "simple-phpunit --fail-on-skipped",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "check": [
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
